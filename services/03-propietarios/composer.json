{
    "name": "clinica/propietarios",
    "version": "1.0.0",
    "description": "Servicio de gestión de propietarios - Clínica Veterinaria Patitas Alegres",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
