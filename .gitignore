# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# ==========================================
# 8. Logs y temporales
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp

# ==========================================
# 9. Bases de datos y dumps
# ==========================================
*.sqlite
*.sqlite3
*.db
# Los dumps de esquema intencionales (database/schema.sql) SÍ se commitean
# Solo ignora dumps locales grandes:
database/dumps/*.sql
!database/schema.sql
!database/seeds/*.sql

