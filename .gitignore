# ==========================================
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.sw?
.classpath
.project
.settings/
*.suo
*.ntvs*
*.njsproj

# ==========================================
