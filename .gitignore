yarn-error.log*
pnpm-debug.log*
coverage/
.npm/
dist/
build/

# ==========================================
# 4. PHP / Composer (03-propietarios, 07-citas, 10-notificaciones)
# ==========================================
vendor/
composer.phar
.phpunit.result.cache
.phpunit.cache/
# NOTA: composer.lock SÍ se commitea (fija versiones para producción)
# NOTA: bin/ y public/ SÍ se commitean (son parte del código)

# ==========================================
# 5. Secretos y entornos
# ==========================================
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.jks
secrets/
# NOTA: asegúrate de que cada servicio tenga su .env.example commiteado

# ==========================================
