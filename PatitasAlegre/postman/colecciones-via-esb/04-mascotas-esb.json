{
  "info": {
    "name": "Patitas Alegre ESB - Mascotas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "esbUrl",
      "value": "http://localhost:8280/services"
    }
  ],
  "item": [
    {
      "name": "Listar mascotas por propietario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "urn:listarMascotas"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<listarMascotasRequest xmlns=\"http://clinica.com/mascotas\">\n  <idPropietario>1</idPropietario>\n</listarMascotasRequest>"
        },
        "url": "{{esbUrl}}/MascotasProxy"
      }
    },
    {
      "name": "Consultar mascota",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "urn:consultarMascota"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<consultarMascotaRequest xmlns=\"http://clinica.com/mascotas\">\n  <idMascota>1</idMascota>\n</consultarMascotaRequest>"
        },
        "url": "{{esbUrl}}/MascotasProxy"
      }
    },
    {
      "name": "Registrar mascota",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "urn:registrarMascota"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<registrarMascotaRequest xmlns=\"http://clinica.com/mascotas\">\n  <idPropietario>1</idPropietario>\n  <idEspecie>1</idEspecie>\n  <idRaza>1</idRaza>\n  <nombre>Pelusa ESB</nombre>\n  <sexo>HEMBRA</sexo>\n  <pesoKg>6.2</pesoKg>\n</registrarMascotaRequest>"
        },
        "url": "{{esbUrl}}/MascotasProxy"
      }
    }
  ]
}
