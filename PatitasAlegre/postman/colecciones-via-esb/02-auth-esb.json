{
  "info": {
    "name": "Patitas Alegre ESB - Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "esbUrl",
      "value": "http://localhost:8280/services"
    }
  ],
  "item": [
    {
      "name": "Iniciar sesión vía ESB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "urn:login"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<loginRequest xmlns=\"http://clinica.com/auth\">\n  <username>admin</username>\n  <password>admin123</password>\n</loginRequest>"
        },
        "url": "{{esbUrl}}/AuthProxy"
      }
    },
    {
      "name": "Validar token vía ESB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "urn:validarToken"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<validarTokenRequest xmlns=\"http://clinica.com/auth\">\n  <token>token_de_prueba_jwt</token>\n</validarTokenRequest>"
        },
        "url": "{{esbUrl}}/AuthProxy"
      }
    }
  ]
}
