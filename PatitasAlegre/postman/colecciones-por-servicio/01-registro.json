{
  "info": {
    "name": "Patitas Alegre - 01 Registro",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Estado del servicio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/registro/estado"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Servicio funcionando', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.estado).to.eql('funcionando');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"cliente_test_\" + Math.floor(Math.random() * 10000),\n  \"email\": \"test_\" + Math.floor(Math.random() * 10000) + \"@clinica.com\",\n  \"password\": \"Password2026!\"\n}"
        },
        "url": "{{baseUrl}}/api/registro"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomId = Math.floor(Math.random() * 100000);",
              "pm.variables.set('randomUser', 'user_' + randomId);",
              "pm.variables.set('randomEmail', 'user_' + randomId + '@clinica.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registro exitoso o duplicado controlado', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Error de validación - correo inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"usuario_invalido\",\n  \"email\": \"correo-sin-formato\",\n  \"password\": \"Password2026!\"\n}"
        },
        "url": "{{baseUrl}}/api/registro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Respuesta 400 por validación', function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Error de validación - contraseña corta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"usuario_pass_corta\",\n  \"email\": \"pass_corta@clinica.com\",\n  \"password\": \"123\"\n}"
        },
        "url": "{{baseUrl}}/api/registro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Respuesta 400 por contraseña corta', function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
