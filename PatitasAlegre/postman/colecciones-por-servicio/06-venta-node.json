{
  "info": {
    "name": "Patitas Alegre - 06 Venta (Node.js)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Salud del servicio y MySQL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/salud"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Servicio conectado a MySQL', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.estado).to.eql('conectado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar productos de accesorios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista de productos devuelta', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    pm.expect(Array.isArray(pm.response.json())).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar categorías de accesorios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/categorias"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista de categorías devuelta', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    pm.expect(pm.response.json().length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrar producto accesorio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"ACC-TEST-\" + Math.floor(Math.random() * 10000),\n  \"nombre\": \"Juguete Mordedor Test\",\n  \"descripcion\": \"Accesorio de prueba para mascotas\",\n  \"idCategoria\": 1,\n  \"precio\": 29.90,\n  \"stock\": 15,\n  \"stockMinimo\": 3\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Producto registrado exitosamente o duplicado controlado', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 500]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Datos incompletos - 400 Bad Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Accesorio Incompleto\"\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Error de validación 400 por campos faltantes', function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
