{
  "info": {
    "name": "Patitas Alegre - 02 Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Probar conexión MySQL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/test-db"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Conexión con MySQL exitosa', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.conectado).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Iniciar sesión (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@clinica.com\",\n  \"password\": \"admin123\",\n  \"rol\": \"ADMIN\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login exitoso con token JWT', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.ok).to.be.true;",
              "    pm.expect(data.token).to.not.be.empty;",
              "    pm.collectionVariables.set('token', data.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Credenciales incorrectas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@clinica.com\",\n  \"password\": \"clave_incorrecta\",\n  \"rol\": \"ADMIN\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rechazo 401 por credenciales incorrectas', function () {",
              "    pm.expect(pm.response.code).to.eql(401);",
              "    var data = pm.response.json();",
              "    pm.expect(data.ok).to.be.false;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rol no correspondiente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@clinica.com\",\n  \"password\": \"admin123\",\n  \"rol\": \"CLIENTE\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rechazo 403 por rol discrepante', function () {",
              "    pm.expect(pm.response.code).to.eql(403);",
              "    var data = pm.response.json();",
              "    pm.expect(data.ok).to.be.false;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Campos incompletos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@clinica.com\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rechazo 400 por campos faltantes', function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
