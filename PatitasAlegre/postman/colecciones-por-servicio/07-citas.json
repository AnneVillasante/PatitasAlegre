{
  "info": {"name": "Patitas Alegre - 07 Citas (aislado)", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:8007"}, {"key": "codigoCita", "value": ""}],
  "item": [
    {"name": "Crear cita sin ESB", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<crearCitaRequest><idPropietario>1</idPropietario><idVeterinario>1</idVeterinario><idMascota>1</idMascota><id_tipo>1</id_tipo><fecha>2026-11-15</fecha><hora>10:00</hora><motivo>Consulta aislada</motivo></crearCitaRequest>"}, "url": "{{baseUrl}}/citas/crear"}, "event": [{"listen": "test", "script": {"exec": ["const match = pm.response.text().match(/<codigo_cita>([^<]+)<\\/codigo_cita>/);", "if (match) pm.collectionVariables.set('codigoCita', match[1]);", "pm.test('Cita confirmada', function () { pm.expect(pm.response.text()).to.include('<estado>CONFIRMADA</estado>'); });"]}}]},
    {"name": "Consultar cita", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<consultarCitaRequest><codigo_cita>{{codigoCita}}</codigo_cita></consultarCitaRequest>"}, "url": "{{baseUrl}}/citas/consultar"}},
    {"name": "Listar por propietario", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<listarCitasRequest><id_propietario>1</id_propietario></listarCitasRequest>"}, "url": "{{baseUrl}}/citas/listar"}},
    {"name": "Cancelar cita", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<cancelarCitaRequest><codigo_cita>{{codigoCita}}</codigo_cita><motivo>Prueba de cancelación</motivo></cancelarCitaRequest>"}, "url": "{{baseUrl}}/citas/cancelar"}},
    {"name": "Fecha pasada", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<crearCitaRequest><idPropietario>1</idPropietario><idVeterinario>1</idVeterinario><idMascota>1</idMascota><fecha>2020-01-01</fecha><hora>10:00</hora></crearCitaRequest>"}, "url": "{{baseUrl}}/citas/crear"}}
  ]
}
