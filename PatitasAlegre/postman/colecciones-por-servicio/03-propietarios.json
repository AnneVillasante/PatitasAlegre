{
  "info": {"name": "Patitas Alegre - 03 Propietarios", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:8003"}, {"key": "dniPrueba", "value": "90000001"}],
  "item": [
    {"name": "Registrar propietario", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<registrarPropietarioRequest><dni>{{dniPrueba}}</dni><nombres>Prueba</nombres><apellidos>Propietario</apellidos><telefono>999999999</telefono><email>prueba@clinica.test</email></registrarPropietarioRequest>"}, "url": "{{baseUrl}}/propietarios/registrar"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('XML y registro exitoso', function () { pm.expect(pm.response.text()).to.include('<estado>REGISTRADO</estado>'); });"]}}]},
    {"name": "DNI duplicado", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<registrarPropietarioRequest><dni>{{dniPrueba}}</dni><nombres>Duplicado</nombres><apellidos>Prueba</apellidos></registrarPropietarioRequest>"}, "url": "{{baseUrl}}/propietarios/registrar"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Devuelve error de negocio', function () { pm.expect(pm.response.text()).to.include('ERROR-NEGOCIO'); });"]}}]},
    {"name": "Consultar propietario", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<consultarPropietarioRequest><dni>{{dniPrueba}}</dni></consultarPropietarioRequest>"}, "url": "{{baseUrl}}/propietarios/consultar"}},
    {"name": "Listar propietarios", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<listarPropietariosRequest/>"}, "url": "{{baseUrl}}/propietarios/listar"}},
    {"name": "DNI inválido", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/xml"}], "body": {"mode": "raw", "raw": "<registrarPropietarioRequest><dni>123</dni><nombres>Inválido</nombres><apellidos>Prueba</apellidos></registrarPropietarioRequest>"}, "url": "{{baseUrl}}/propietarios/registrar"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Devuelve error de validación', function () { pm.expect(pm.response.text()).to.include('ERROR-VALIDACION'); });"]}}]}
  ]
}
