{
    "name": "clinica/notificaciones",
    "version": "1.0.0",
    "description": "Servicio de Notificaciones Email/SMS - Arquitectura SOA",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "stomp-php/stomp-php": "^5.1",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-libxml": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
