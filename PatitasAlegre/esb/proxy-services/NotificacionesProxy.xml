<proxy name="NotificacionesProxy" startOnLoad="true" transports="http https" xmlns="http://ws.apache.org/ns/synapse">
    <target>
        <inSequence>
            <property name="ESB_ORIGIN" value="WSO2" scope="transport"/>
            <log level="custom"><property name="VETRO_SERVICE" value="Notificaciones"/></log>
            <validate source="//*[local-name()='enviarNotificacionRequest']">
                <schema key="conf:/xsd/notificaciones.xsd"/>
                <on-fail><makefault response="true"><code value="tns:VALIDATION_ERROR"/><reason value="XML de notificaciones inválido"/></makefault><respond/></on-fail>
            </validate>
            <send><endpoint><address uri="http://localhost:8010/notificaciones/enviar"/></endpoint></send>
        </inSequence>
        <outSequence><log level="custom"><property name="VETRO_OPERATE" value="Notificaciones response"/></log><send/></outSequence>
        <faultSequence><log level="full"/><drop/></faultSequence>
    </target>
</proxy>
